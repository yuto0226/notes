---
import '@/styles/footnotes.css'
import '@/styles/global.css'
import '@/styles/typography.css'

import Footer from '@/components/Footer.astro'
import Head from '@/components/Head.astro'
import Header from '@/components/Header.astro'
import { SITE } from '@/consts'
import { cn } from '@/lib/utils'
import Analytics from '@vercel/analytics/astro'
import SpeedInsights from '@vercel/speed-insights/astro'

interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<!doctype html>
<html
  class="bg-background text-foreground scheme-light-dark"
  lang={SITE.locale}
>
  <Head>
    <slot name="head" />
  </Head>
  <body class="flex h-fit min-h-screen flex-col gap-y-6 font-sans">
    <!-- enable LQIP only when JavaScript can mark loaded images -->
    <script is:inline data-astro-rerun>
      document.documentElement.classList.add('js')
    </script>
    <div
      class="page-transition-overlay is-active is-revealing"
      transition:persist
      aria-hidden="true"
    >
      <div class="page-transition-mark">
        <span class="page-transition-title">{SITE.title}</span>
        <span class="page-transition-caret"></span>
      </div>
    </div>
    <script is:inline>
      const overlay = document.querySelector('.page-transition-overlay')
      const mark = overlay?.querySelector('.page-transition-mark')

      if (overlay && mark) {
        const gap =
          Number.parseFloat(
            getComputedStyle(document.documentElement).fontSize,
          ) / 2
        overlay.style.setProperty(
          '--page-transition-caret-distance',
          `${mark.getBoundingClientRect().width + gap}px`,
        )
      }
    </script>
    <header
      class="bg-background/50 sticky top-0 z-50 divide-y backdrop-blur-sm xl:divide-none"
    >
      <Header />
      <slot name="subposts-navigation" />
      <slot name="table-of-contents" />
    </header>
    <main
      class={cn('w-full mx-auto flex grow flex-col gap-y-6 px-4', className)}
    >
      <slot />
    </main>
    <Footer />
    <SpeedInsights />
    <Analytics />
    <script>
      const transitionOverlayDuration = 580
      let transitionOverlayShownAt = performance.now()
      let transitionOverlayHideTimer: number | undefined

      const wait = (duration: number) =>
        new Promise((resolve) => window.setTimeout(resolve, duration))

      const nextFrame = () =>
        new Promise((resolve) => requestAnimationFrame(resolve))

      const getTransitionOverlay = () =>
        document.querySelector<HTMLElement>('.page-transition-overlay')

      const setTransitionCaretDistance = (overlay: HTMLElement) => {
        const mark = overlay.querySelector<HTMLElement>('.page-transition-mark')
        if (!mark) return

        const gap =
          Number.parseFloat(
            getComputedStyle(document.documentElement).fontSize,
          ) / 2
        overlay.style.setProperty(
          '--page-transition-caret-distance',
          `${mark.getBoundingClientRect().width + gap}px`,
        )
      }

      const showTransitionOverlay = () => {
        window.clearTimeout(transitionOverlayHideTimer)
        transitionOverlayShownAt = performance.now()
        const overlay = getTransitionOverlay()
        if (!overlay) return

        overlay.classList.remove('is-ready', 'is-revealing')
        overlay.classList.add('is-active')
        setTransitionCaretDistance(overlay)
        void overlay.offsetWidth
        overlay.classList.add('is-revealing')
      }

      const hideTransitionOverlay = () => {
        const elapsed = performance.now() - transitionOverlayShownAt
        const remaining = Math.max(transitionOverlayDuration - elapsed, 0)

        transitionOverlayHideTimer = window.setTimeout(() => {
          getTransitionOverlay()?.classList.remove(
            'is-active',
            'is-ready',
            'is-revealing',
          )
        }, remaining)
      }

      document.addEventListener('astro:before-preparation', (event) => {
        document.documentElement.classList.add('js')
        const nextUrl = new URL(event.to.href)

        if (
          nextUrl.pathname === location.pathname &&
          nextUrl.search === location.search &&
          nextUrl.hash !== location.hash
        ) {
          return
        }

        const loadPage = event.loader

        event.loader = async () => {
          showTransitionOverlay()
          await nextFrame()
          await Promise.all([loadPage(), wait(transitionOverlayDuration)])
          const overlay = getTransitionOverlay()
          overlay?.classList.remove('is-revealing')
          overlay?.classList.add('is-ready')
        }
      })

      document.addEventListener('astro:page-load', hideTransitionOverlay)

      const revealImage = (image: HTMLImageElement) => {
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            image.classList.add('is-loaded')
          })
        })
      }

      const setupRevealImage = (image: HTMLImageElement) => {
        if (image.dataset.revealBound) return

        image.dataset.revealBound = 'true'

        if (image.complete && image.naturalWidth > 0) {
          revealImage(image)
          return
        }

        image.addEventListener('load', () => revealImage(image), {
          once: true,
        })
      }

      const setupRevealImages = () => {
        document
          .querySelectorAll<HTMLImageElement>(
            'img[data-lqip-image], img[data-remote-image]',
          )
          .forEach(setupRevealImage)
      }

      const revealObserver = new MutationObserver(setupRevealImages)

      document.addEventListener('astro:page-load', () => {
        setupRevealImages()
        revealObserver.observe(document.body, {
          childList: true,
          subtree: true,
        })
      })

      document.addEventListener('astro:after-swap', setupRevealImages)
    </script>
  </body>
</html>
