---
import '@/styles/global.css'
import '@/styles/typography.css'

import Footer from '@/components/Footer.astro'
import Head from '@/components/Head.astro'
import Header from '@/components/Header.astro'
import { SITE } from '@/consts'
import { cn } from '@/lib/utils'
import Analytics from '@vercel/analytics/astro'
import SpeedInsights from '@vercel/speed-insights/astro'

interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<!doctype html>
<html
  class="bg-background text-foreground scheme-light-dark"
  lang={SITE.locale}
>
  <Head>
    <slot name="head" />
  </Head>
  <body class="flex h-fit min-h-screen flex-col gap-y-6 font-sans">
    <!-- enable LQIP only when JavaScript can mark loaded images -->
    <script is:inline>
      document.documentElement.classList.add('js')
    </script>
    <header
      class="bg-background/50 sticky top-0 z-50 divide-y backdrop-blur-sm xl:divide-none"
    >
      <Header />
      <slot name="subposts-navigation" />
      <slot name="table-of-contents" />
    </header>
    <main
      class={cn('w-full mx-auto flex grow flex-col gap-y-6 px-4', className)}
    >
      <slot />
    </main>
    <Footer />
    <SpeedInsights />
    <Analytics />
    <script>
      const setupLqipImages = () => {
        document
          .querySelectorAll<HTMLImageElement>('img[data-lqip-image]')
          .forEach((image) => {
            if (image.complete) {
              image.classList.add('is-loaded')
              return
            }

            image.addEventListener(
              'load',
              () => {
                image.classList.add('is-loaded')
              },
              { once: true },
            )
          })
      }

      document.addEventListener('astro:page-load', setupLqipImages)
      document.addEventListener('astro:after-swap', setupLqipImages)
    </script>
  </body>
</html>
