---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import EssayEntry from '@/components/EssayEntry.astro'
import PageHead from '@/components/PageHead.astro'
import PaginationComponent from '@/components/ui/pagination'
import Layout from '@/layouts/Layout.astro'
import { getPublicEssays } from '@/lib/essays'
import type { PaginateFunction } from 'astro'

const description = 'Personal reflections, daily life, travel, and brief ideas.'

export async function getStaticPaths({
  paginate,
}: {
  paginate: PaginateFunction
}) {
  const essays = await getPublicEssays()
  return paginate(essays, { pageSize: 12 })
}

const { page } = Astro.props
const isFirstPage = page.currentPage === 1
const title = isFirstPage ? 'Essays' : `Essays — Page ${page.currentPage}`
---

<Layout class="max-w-4xl">
  <PageHead slot="head" title={title} description={description} />
  <Breadcrumbs
    items={isFirstPage
      ? [{ label: 'Essays', icon: 'lucide:feather' }]
      : [
          { label: 'Essays', href: '/essays', icon: 'lucide:feather' },
          {
            label: `Page ${page.currentPage}`,
            icon: 'lucide:book-copy',
          },
        ]}
  />

  {
    isFirstPage && (
      <section class="rounded-lg border">
        <div class="flex flex-col space-y-1.5 p-6">
          <h3 class="text-3xl leading-none font-medium">Him·mel</h3>
          <p class="text-muted-foreground text-sm">
            /ˈhɪməl/ &bull; <span class="font-medium">German</span> &bull; sky,
            heaven
          </p>
        </div>
        <div class="p-6 pt-0">
          <p class="text-muted-foreground text-sm">
            A hero whose journey ended long ago, yet whose legacy continues to
            ripple through time. In the brief span of a human life, he touched
            countless souls—not through grand gestures, but through small acts
            of kindness that changed everything.
          </p>
        </div>
        <div class="p-6 pt-0">
          <p class="text-md mb-4 text-center">
            -- ヒンメルはなんで人助けをするの？ --
          </p>
          <blockquote class="text-muted-foreground my-6 border-l-2 pl-6 italic">
            ほんの少しでいい。誰かの人生を変えてあげればいい。きっとそれだけで十分なだ。
            <br />— 勇者 ヒンメル
          </blockquote>
        </div>
      </section>
    )
  }

  <section class={isFirstPage ? 'pt-4' : undefined} aria-label="Essay archive">
    {
      page.data.length > 0 ? (
        <div>
          {page.data.map((essay) => (
            <EssayEntry entry={essay} />
          ))}
        </div>
      ) : (
        isFirstPage && (
          <p class="text-muted-foreground border-border border-t py-10 text-center text-sm italic">
            The thoughts are still in mind, waiting quietly to become words.
          </p>
        )
      )
    }
  </section>

  {
    page.lastPage > 1 && (
      <PaginationComponent
        currentPage={page.currentPage}
        totalPages={page.lastPage}
        baseUrl="/essays/"
        client:load
      />
    )
  }
</Layout>
