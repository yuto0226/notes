---
import AuthorCard from '@/components/AuthorCard.astro'
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import EssayEntry from '@/components/EssayEntry.astro'
import NoteCard from '@/components/NoteCard.astro'
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import { getAllAuthors, getEntriesByAuthor } from '@/lib/data-utils'

export async function getStaticPaths() {
  const authors = await getAllAuthors()
  return authors.map((author) => ({
    params: { id: author.id },
    props: { author },
  }))
}

const { author } = Astro.props
const { essays, notes } = await getEntriesByAuthor(author.id)
---

<Layout class="max-w-4xl">
  <PageHead
    slot="head"
    title={`${author.data.name} (Author)`}
    description={author.data.bio || `Profile of ${author.data.name}.`}
    noindex
  />
  <Breadcrumbs
    items={[
      { href: '/authors', label: 'Authors', icon: 'lucide:users' },
      { label: author.data.name, icon: 'lucide:user' },
    ]}
  />

  <section>
    <AuthorCard author={author} />
  </section>
  <section class="flex flex-col gap-y-4">
    <h2 class="text-2xl font-medium">Essays by {author.data.name}</h2>
    {
      essays.length > 0 ? (
        <div>
          {essays.map((essay) => (
            <EssayEntry entry={essay} />
          ))}
        </div>
      ) : (
        <p class="text-muted-foreground">
          No essays available from this author.
        </p>
      )
    }
  </section>
  <section class="flex flex-col gap-y-4">
    <h2 class="text-2xl font-medium">Notes by {author.data.name}</h2>
    {
      notes.length > 0 ? (
        <ul class="flex flex-col gap-4">
          {notes.map((note) => (
            <li>
              <NoteCard entry={note} showSubposts={false} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-muted-foreground">
          No notes available from this author.
        </p>
      )
    }
  </section>
</Layout>
