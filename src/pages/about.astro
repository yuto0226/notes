---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import FriendCard from '@/components/FriendCard.astro'
import PageHead from '@/components/PageHead.astro'
import ProjectCard from '@/components/ProjectCard.astro'
import Layout from '@/layouts/Layout.astro'
import {
  getAllFriends,
  getAllMilestones,
  getAllProjects,
} from '@/lib/data-utils'
import {
  formatMilestoneDateRange,
  formatMilestoneDatetime,
  getMilestoneMeta,
} from '@/lib/milestones'
import { render } from 'astro:content'

const projects = await getAllProjects()
const milestones = await getAllMilestones()
const friends = await getAllFriends()
const renderedMilestones = await Promise.all(
  milestones.map(async (milestone) => {
    const { Content } = await render(milestone)
    return { milestone, Content }
  }),
)
---

<Layout class="max-w-4xl">
  <PageHead slot="head" title="About" />
  <Breadcrumbs items={[{ label: 'About', icon: 'lucide:info' }]} />

  <section>
    <div class="min-w-full">
      <div class="prose mb-8">
        <p class="mt-0">這裡應該要放自我介紹吧？但我還沒整理好 (¦3[▓▓]</p>
      </div>

      {
        renderedMilestones.length > 0 && (
          <section class="mb-8">
            <h2 class="mb-4 text-2xl font-medium">Milestones</h2>
            <ol class="border-foreground/25 space-y-5 border-l">
              {renderedMilestones.map(({ milestone, Content }) => (
                <li class="relative pl-5">
                  <span
                    class="bg-background border-primary ring-background absolute top-1.5 -left-[5px] size-2.5 rounded-full border-2 ring-4"
                    aria-hidden="true"
                  />
                  <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-3">
                    <time
                      datetime={formatMilestoneDatetime(
                        milestone.data.startDate,
                      )}
                      class="text-muted-foreground shrink-0 font-mono text-sm"
                      aria-label={formatMilestoneDateRange(milestone.data)}
                    >
                      {formatMilestoneDateRange(milestone.data)}
                    </time>
                    <div class="flex flex-wrap items-baseline gap-x-1">
                      <h3 class="text-base font-medium">
                        {milestone.data.title}
                      </h3>
                      {getMilestoneMeta(milestone.data) && (
                        <span class="text-muted-foreground text-base">
                          · {getMilestoneMeta(milestone.data)}
                        </span>
                      )}
                    </div>
                  </div>
                  {milestone.body && (
                    <div class="prose small mt-2">
                      <Content />
                    </div>
                  )}
                </li>
              ))}
            </ol>
          </section>
        )
      }

      <h2 class="mb-4 text-2xl font-medium">Projects</h2>
      <div class="flex flex-col gap-4">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>

      <h2 class="mt-8 mb-4 text-2xl font-medium">Friends</h2>
      {
        friends.length > 0 ? (
          <ul class="mb-12 list-none columns-1 gap-4 space-y-4 pl-0 md:columns-2">
            {friends.map((friend) => (
              <li class="break-inside-avoid">
                <FriendCard friend={friend} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-muted-foreground mb-12 text-center">
            No friends found. ｡ﾟヽ(ﾟ´Д`)ﾉﾟ｡
          </p>
        )
      }
    </div>
  </section>
</Layout>
