---
import NoteDetailPage from '@/components/pages/NoteDetailPage.astro'
import { getAllNotesAndSubposts } from '@/lib/data-utils'
import { isSeriesEntry } from '@/lib/series'

export async function getStaticPaths() {
  const notes = await getAllNotesAndSubposts()
  return notes
    .filter((note) => !isSeriesEntry(note.id))
    .map((note) => ({
      params: { id: note.id },
      props: note,
    }))
}

const note = Astro.props
const currentNoteId = Astro.params.id as string
---

<NoteDetailPage note={note} currentNoteId={currentNoteId} />
