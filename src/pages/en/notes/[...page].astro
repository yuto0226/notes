---
import NotesArchivePage from '@/components/pages/NotesArchivePage.astro'
import { SITE } from '@/consts'
import { getRegularNotes } from '@/lib/data-utils'
import type { PaginateFunction } from 'astro'

export async function getStaticPaths({
  paginate,
}: {
  paginate: PaginateFunction
}) {
  const regularNotes = await getRegularNotes()
  return paginate(regularNotes, { pageSize: SITE.postsPerPage })
}

const { page } = Astro.props
---

<NotesArchivePage page={page} />
