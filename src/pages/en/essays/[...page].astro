---
import EssaysArchivePage from '@/components/pages/EssaysArchivePage.astro'
import { getPublicEssays } from '@/lib/essays'
import type { PaginateFunction } from 'astro'

export async function getStaticPaths({
  paginate,
}: {
  paginate: PaginateFunction
}) {
  const essays = await getPublicEssays()
  return paginate(essays, { pageSize: 12 })
}

const { page } = Astro.props
---

<EssaysArchivePage page={page} />
