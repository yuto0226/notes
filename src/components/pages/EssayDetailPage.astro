---
import PostDetail from '@/components/PostDetail.astro'
import { defaultLang, useTranslations } from '@/i18n/ui'
import { localeHref } from '@/i18n/utils'
import { parseAuthors, type TOCSection } from '@/lib/data-utils'
import { getDisplayEssay } from '@/lib/essays'
import { calculateWordCountFromHtml, readingTime } from '@/lib/utils'
import type { CollectionEntry } from 'astro:content'
import { render } from 'astro:content'

interface Props {
  essay: CollectionEntry<'essays'>
}

const { essay } = Astro.props
const locale = Astro.currentLocale ?? defaultLang
const t = useTranslations(locale)
const currentEssayId = essay.id

const {
  entry: displayEntry,
  isTranslated,
  hasTranslation,
} = await getDisplayEssay(essay, locale)

const { Content, headings } = await render(displayEntry)
const authors = await parseAuthors(displayEntry.data.authors ?? [])
const readingTimeText = readingTime(
  calculateWordCountFromHtml(displayEntry.body),
  locale,
)
const alternateHref = hasTranslation
  ? locale === 'en'
    ? new URL(`/essays/${currentEssayId}`, Astro.site).href
    : new URL(`/en/essays/${currentEssayId}`, Astro.site).href
  : undefined
const tocSections: TOCSection[] = headings.length
  ? [
      {
        type: 'parent',
        title: 'Overview',
        headings: headings.map((heading) => ({
          slug: heading.slug,
          text: heading.text,
          depth: heading.depth,
        })),
      },
    ]
  : []
const essaysHref = localeHref(locale, '/essays')
const essayHref = localeHref(locale, `/essays/${currentEssayId}`)
const breadcrumbItems = [
  { href: essaysHref, label: t('common.essays'), icon: 'lucide:feather' },
  {
    href: essayHref,
    label: displayEntry.data.title,
    icon: 'lucide:file-text',
  },
]
---

<PostDetail
  entry={displayEntry}
  currentEntryId={currentEssayId}
  Content={Content}
  headings={headings}
  breadcrumbItems={breadcrumbItems}
  authors={authors}
  readingTimeText={readingTimeText}
  heroImage={displayEntry.data.image}
  tocSections={tocSections}
  tocIsCurrentSubpost={false}
  isTranslated={isTranslated}
  alternateHref={alternateHref}
/>
