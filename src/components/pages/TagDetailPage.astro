---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import EssayEntry from '@/components/EssayEntry.astro'
import NoteCard from '@/components/NoteCard.astro'
import PageHead from '@/components/PageHead.astro'
import { defaultLang, useTranslations } from '@/i18n/ui'
import { localeHref } from '@/i18n/utils'
import Layout from '@/layouts/Layout.astro'
import type { TagEntry } from '@/lib/data-utils'

interface Props {
  tag: string
  entries: TagEntry[]
}

const { tag, entries } = Astro.props
const locale = Astro.currentLocale ?? defaultLang
const t = useTranslations(locale)
const essays = entries.filter((entry) => entry.collection === 'essays')
const notes = entries.filter((entry) => entry.collection === 'notes')
---

<Layout class="max-w-4xl">
  <PageHead
    slot="head"
    title={t('tags.pageTitle', { tag })}
    description={t('tags.pageDescription', { tag })}
    noindex
  />
  <Breadcrumbs
    items={[
      {
        href: localeHref(locale, '/tags'),
        label: t('common.tags'),
        icon: 'lucide:tags',
      },
      { label: tag, icon: 'lucide:tag' },
    ]}
  />

  {
    essays.length > 0 && (
      <section>
        <h2 class="mb-4 text-2xl font-medium">{t('common.essays')}</h2>
        <ul class="flex flex-col gap-y-4">
          {essays.map((entry) => (
            <li>
              <EssayEntry entry={entry} />
            </li>
          ))}
        </ul>
      </section>
    )
  }
  {
    notes.length > 0 && (
      <section>
        <h2 class="mb-4 text-2xl font-medium">{t('common.notes')}</h2>
        <ul class="flex flex-col gap-y-4">
          {notes.map((entry) => (
            <li>
              <NoteCard entry={entry} showSubposts={false} />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Layout>
