---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import Link from '@/components/Link.astro'
import PageHead from '@/components/PageHead.astro'
import { buttonVariants } from '@/components/ui/button'
import { defaultLang, useTranslations } from '@/i18n/ui'
import { localeHref } from '@/i18n/utils'
import Layout from '@/layouts/Layout.astro'
import { cn } from '@/lib/utils'

const locale = Astro.currentLocale ?? defaultLang
const t = useTranslations(locale)
---

<Layout class="max-w-4xl">
  <PageHead slot="head" title="404" noindex />
  <Breadcrumbs
    items={[{ label: t('notfound.breadcrumb'), icon: 'lucide:circle-help' }]}
  />

  <section
    class="flex flex-col items-center justify-center gap-y-4 text-center"
  >
    <div class="max-w-md">
      <h1 class="mb-4 text-3xl font-medium">{t('notfound.heading')}</h1>
      <p class="prose">{t('notfound.body')}</p>
    </div>
    <Link
      href={localeHref(locale, '/')}
      class={cn(buttonVariants({ variant: 'outline' }), 'flex gap-x-1.5 group')}
    >
      <span class="transition-transform group-hover:-translate-x-1">&larr;</span
      >
      {t('notfound.goHome')}
    </Link>
  </section>
</Layout>
