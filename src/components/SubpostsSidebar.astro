---
import Link from '@/components/Link.astro'
import { ScrollArea } from '@/components/ui/scroll-area'
import { defaultLang, useTranslations } from '@/i18n/ui'
import {
  getCombinedReadingTime,
  getNoteById,
  getNoteReadingTime,
  getParentId,
  getParentNote,
  getSubpostsForParent,
  isSubpost,
} from '@/lib/data-utils'
import { Icon } from 'astro-icon/components'

type Props = {
  parentId: string
  currentEntryId: string
}

const { parentId, currentEntryId: currentPostId } = Astro.props
const locale = Astro.currentLocale ?? defaultLang
const t = useTranslations(locale)
const isCurrentSubpost = isSubpost(currentPostId)
const rootParentId = isCurrentSubpost ? getParentId(currentPostId) : parentId

const currentPost = !isCurrentSubpost ? await getNoteById(currentPostId) : null
const subposts = await getSubpostsForParent(rootParentId)
const parentPost = isCurrentSubpost ? await getParentNote(currentPostId) : null

const activePost = parentPost || currentPost
const isActivePost = activePost?.id === currentPostId

const activePostReadingTime = activePost
  ? await getNoteReadingTime(activePost.id, locale)
  : null
const activePostCombinedReadingTime =
  activePost && subposts.length > 0
    ? await getCombinedReadingTime(activePost.id, locale)
    : null
const subpostsWithReadingTime = await Promise.all(
  subposts.map(async (subpost) => ({
    ...subpost,
    readingTime: await getNoteReadingTime(subpost.id, locale),
  })),
)
---

<div
  id="subposts-sidebar-container"
  class="pointer-events-none fixed right-[max(1rem,calc(50%-43rem))] z-10 hidden w-[clamp(14rem,calc(50vw-29rem),16rem)] xl:block"
  style="top: var(--subposts-top, 5rem); max-height: var(--subposts-height, calc(100vh - 6rem));"
>
  <div data-subposts-sidebar-scroll>
    <ScrollArea
      client:load
      className="flex max-h-[calc(100vh-8rem)] flex-col overflow-y-auto"
    >
      <div class="bg-background/50 pointer-events-auto px-4 backdrop-blur-sm">
        <ul class="space-y-1">
          {
            activePost && (
              <li>
                {isActivePost ? (
                  <div class="text-foreground bg-foreground/5 subposts-sidebar-active-item flex items-center gap-2 rounded-md py-1.5 pr-3 pl-2 text-sm font-medium text-pretty">
                    <Icon
                      name="lucide:book-open-text"
                      class="size-4 shrink-0"
                      aria-hidden="true"
                    />
                    <div class="flex flex-col">
                      <span class="line-clamp-2 text-pretty">
                        {activePost.data.title}
                      </span>
                      {activePostReadingTime && (
                        <span class="text-muted-foreground/80 text-xs">
                          {activePostReadingTime}
                          {activePostCombinedReadingTime &&
                            activePostCombinedReadingTime !==
                              activePostReadingTime && (
                              <span>
                                {' '}
                                {t('post.readingTimeTotal', {
                                  time: activePostCombinedReadingTime,
                                })}
                              </span>
                            )}
                        </span>
                      )}
                    </div>
                  </div>
                ) : (
                  <Link
                    href={`/notes/${activePost.id}#post-title`}
                    class="hover:text-foreground text-muted-foreground hover:bg-foreground/5 subposts-sidebar-link flex items-center gap-2 rounded-md px-2 py-1.5 text-sm text-pretty transition-colors"
                  >
                    <Icon
                      name="lucide:book-open"
                      class="size-4 shrink-0"
                      aria-hidden="true"
                    />
                    <div class="flex flex-col">
                      <span class="line-clamp-2 text-pretty">
                        {activePost.data.title}
                      </span>
                      {activePostReadingTime && (
                        <span class="text-muted-foreground/80 text-xs">
                          {activePostReadingTime}
                          {activePostCombinedReadingTime &&
                            activePostCombinedReadingTime !==
                              activePostReadingTime && (
                              <span>
                                {' '}
                                {t('post.readingTimeTotal', {
                                  time: activePostCombinedReadingTime,
                                })}
                              </span>
                            )}
                        </span>
                      )}
                    </div>
                  </Link>
                )}
              </li>
            )
          }

          {
            subpostsWithReadingTime.length > 0 &&
              subpostsWithReadingTime.map((subpost) => (
                <li class="ml-4">
                  {currentPostId === subpost.id ? (
                    <div class="text-foreground bg-foreground/5 subposts-sidebar-active-item flex items-center gap-2 rounded-md px-2 py-1.5 text-sm font-medium text-pretty">
                      <Icon
                        name="lucide:file-text"
                        class="size-4 shrink-0"
                        aria-hidden="true"
                      />
                      <div class="flex flex-col">
                        <span class="line-clamp-2 text-pretty">
                          {subpost.data.title}
                        </span>
                        <span class="text-muted-foreground/80 text-xs">
                          {subpost.readingTime}
                        </span>
                      </div>
                    </div>
                  ) : (
                    <Link
                      href={`/notes/${subpost.id}`}
                      class="hover:text-foreground text-muted-foreground hover:bg-foreground/5 subposts-sidebar-link flex items-center gap-2 rounded-md px-2 py-1.5 text-sm text-pretty transition-colors"
                    >
                      <Icon
                        name="lucide:file"
                        class="size-4 shrink-0"
                        aria-hidden="true"
                      />
                      <div class="flex flex-col">
                        <span class="line-clamp-2 text-pretty">
                          {subpost.data.title}
                        </span>
                        <span class="text-muted-foreground/80 text-xs">
                          {subpost.readingTime}
                        </span>
                      </div>
                    </Link>
                  )}
                </li>
              ))
          }
        </ul>
      </div>
    </ScrollArea>
  </div>
</div>

<script>
  class SidebarState {
    scrollArea: HTMLElement | null = null
    sidebarScrollArea: HTMLElement | null = null
    container: HTMLElement | null = null
    anchor: HTMLElement | null = null
    positionFrame: number | null = null
    resizeObserver: ResizeObserver | null = null

    reset() {
      this.scrollArea = null
      this.sidebarScrollArea = null
      this.container = null
      this.anchor = null
      this.positionFrame = null
      this.resizeObserver = null
    }
  }

  const state = new SidebarState()

  class SidebarScrollMask {
    static update() {
      if (!state.scrollArea || !state.sidebarScrollArea) return

      const { scrollTop, scrollHeight, clientHeight } = state.scrollArea
      const threshold = 5
      const isAtTop = scrollTop <= threshold
      const isAtBottom = scrollTop >= scrollHeight - clientHeight - threshold

      state.sidebarScrollArea.classList.toggle('mask-t-from-90%', !isAtTop)
      state.sidebarScrollArea.classList.toggle('mask-b-from-90%', !isAtBottom)
    }
  }

  class SidebarScroll {
    static toActive() {
      if (!state.scrollArea) return

      const activeItem = state.scrollArea.querySelector(
        '.subposts-sidebar-active-item',
      )
      if (!activeItem) {
        return
      }

      const { top: areaTop, height: areaHeight } =
        state.scrollArea.getBoundingClientRect()
      const { top: itemTop, height: itemHeight } =
        activeItem.getBoundingClientRect()

      const currentItemTop = itemTop - areaTop + state.scrollArea.scrollTop
      const targetScroll = Math.max(
        0,
        Math.min(
          currentItemTop - (areaHeight - itemHeight) / 2,
          state.scrollArea.scrollHeight - state.scrollArea.clientHeight,
        ),
      )

      state.scrollArea.scrollTop = targetScroll
    }
  }

  class SidebarPosition {
    static readonly STICKY_TOP = 80
    static readonly VIEWPORT_BOTTOM_GAP = 16

    static update() {
      if (!state.container || !state.anchor) return

      const anchorTop = state.anchor.getBoundingClientRect().top
      const top = Math.max(this.STICKY_TOP, anchorTop)
      const height = Math.max(
        0,
        window.innerHeight - top - this.VIEWPORT_BOTTOM_GAP,
      )

      state.container.style.setProperty('--subposts-top', `${top}px`)
      state.container.style.setProperty('--subposts-height', `${height}px`)
    }

    static scheduleUpdate = () => {
      if (state.positionFrame !== null) return

      state.positionFrame = window.requestAnimationFrame(() => {
        state.positionFrame = null
        this.update()
      })
    }

    static init() {
      this.update()

      if (!state.anchor) return

      state.resizeObserver = new ResizeObserver(() => this.scheduleUpdate())
      state.resizeObserver.observe(state.anchor)
      document.fonts?.ready.then(() => this.scheduleUpdate())
    }

    static cleanup() {
      if (state.positionFrame !== null) {
        window.cancelAnimationFrame(state.positionFrame)
        state.positionFrame = null
      }

      state.resizeObserver?.disconnect()
      state.resizeObserver = null
    }
  }

  class SidebarController {
    static handlePositionChange = () => SidebarPosition.scheduleUpdate()

    static init() {
      state.reset()

      const sidebarContainer = document.getElementById(
        'subposts-sidebar-container',
      )
      if (sidebarContainer) {
        state.container = sidebarContainer
        state.anchor = document.querySelector('[data-toc-anchor]')
        state.scrollArea = sidebarContainer.querySelector(
          '[data-radix-scroll-area-viewport]',
        )
        state.sidebarScrollArea = sidebarContainer.querySelector(
          '[data-subposts-sidebar-scroll]',
        )

        if (state.scrollArea) {
          state.scrollArea.addEventListener(
            'scroll',
            SidebarScrollMask.update,
            { passive: true },
          )
        }

        SidebarPosition.init()

        const options = { passive: true }
        window.addEventListener('scroll', this.handlePositionChange, options)
        window.addEventListener('resize', this.handlePositionChange, options)

        requestAnimationFrame(() => {
          SidebarScroll.toActive()
          setTimeout(SidebarScrollMask.update, 100)
        })
      }
    }

    static cleanup() {
      SidebarPosition.cleanup()
      window.removeEventListener('scroll', this.handlePositionChange)
      window.removeEventListener('resize', this.handlePositionChange)
      if (state.scrollArea) {
        state.scrollArea.removeEventListener('scroll', SidebarScrollMask.update)
      }
      state.reset()
    }
  }

  document.addEventListener('astro:page-load', () => SidebarController.init())
  document.addEventListener('astro:after-swap', () => {
    SidebarController.cleanup()
    SidebarController.init()
  })
  document.addEventListener('astro:before-swap', () =>
    SidebarController.cleanup(),
  )
</script>
