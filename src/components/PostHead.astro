---
import JsonLd from '@/components/JsonLd.astro'
import { SITE } from '@/consts'
import {
  buildBlogPostingSchema,
  buildBreadcrumbListSchema,
  type StructuredDataAuthor,
  type StructuredDataBreadcrumb,
} from '@/lib/structured-data'
import type { CollectionEntry } from 'astro:content'

interface Props {
  post: CollectionEntry<'notes'> | CollectionEntry<'essays'>
  canonicalHref?: string
  contentLocale?: string
  alternateHref?: string
  alternateLocale?: string
  authors: StructuredDataAuthor[]
  breadcrumbs: StructuredDataBreadcrumb[]
}

const {
  post,
  canonicalHref,
  contentLocale,
  alternateHref,
  alternateLocale,
  authors,
  breadcrumbs,
} = Astro.props
const title = post.data.title || SITE.title
const description = post.data.description || SITE.description
const author =
  post.data.authors && post.data.authors.length > 0
    ? post.data.authors.join(', ')
    : SITE.author
const ogImage = `${SITE.href}/og/${post.collection}/${post.id}.png`
const canonicalUrl = canonicalHref ?? Astro.url.href
const publishedTime = post.data.date.toISOString()
const modifiedTime = post.data.updated?.toISOString()
const locale = contentLocale ?? SITE.locale
---

<title>{`${title} | ${SITE.title}`}</title>
<meta name="title" content={`${title} | ${SITE.title}`} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
{
  alternateHref && alternateLocale && (
    <>
      <link rel="alternate" hreflang={contentLocale} href={canonicalUrl} />
      <link rel="alternate" hreflang={alternateLocale} href={alternateHref} />
    </>
  )
}

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:type" content="article" />
<meta property="article:published_time" content={publishedTime} />
{
  post.data.updated && (
    <meta property="article:modified_time" content={modifiedTime} />
  )
}
<meta property="og:locale" content={locale} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:url" content={Astro.url} />
<meta property="og:author" content={author} />

<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={title} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:creator" content={author} />

{
  post?.data.tags &&
    post.data.tags.map((tag: string) => {
      return <meta property="article:tag" content={tag} />
    })
}

<JsonLd
  data={buildBlogPostingSchema({
    canonicalUrl,
    headline: title,
    description,
    image: ogImage,
    datePublished: publishedTime,
    dateModified: modifiedTime,
    inLanguage: locale,
    authors,
  })}
/>
<JsonLd data={buildBreadcrumbListSchema(breadcrumbs)} />
