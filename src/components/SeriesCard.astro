---
import Link from '@/components/Link.astro'
import LqipImage from '@/components/LqipImage.astro'
import type { NoteSeries } from '@/lib/series'
import { Icon } from 'astro-icon/components'

interface Props {
  series: NoteSeries
}

const { series } = Astro.props
---

<article
  class="hover:bg-muted/50 rounded-xl border p-4 transition-colors duration-300 ease-in-out"
  data-series-card={series.id}
>
  <Link href={`/notes/${series.id}`} class="group flex h-full flex-col gap-4">
    {
      series.parent.data.image && (
        <LqipImage
          src={series.parent.data.image}
          alt={series.parent.data.title}
          width={1200}
          height={630}
          class="w-full"
          imgClass="object-cover"
        />
      )
    }

    <div class="flex grow flex-col">
      <h3 class="text-lg leading-snug font-medium text-pretty">
        {series.parent.data.title}
      </h3>
      <p class="text-muted-foreground mt-2 grow text-sm leading-relaxed">
        {series.parent.data.description}
      </p>
      <div
        class="text-muted-foreground mt-4 flex items-center justify-between text-xs"
      >
        <span>{series.entries.length} notes</span>
        <Icon
          name="lucide:arrow-right"
          class="size-4 transition-transform group-hover:translate-x-1"
          aria-hidden="true"
        />
      </div>
    </div>
  </Link>
</article>
