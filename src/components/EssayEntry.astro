---
import Link from '@/components/Link.astro'
import LqipImage from '@/components/LqipImage.astro'
import { formatDate } from '@/lib/utils'
import type { CollectionEntry } from 'astro:content'

interface Props {
  entry: CollectionEntry<'essays'>
}

const { entry } = Astro.props
const description = entry.data.description.trim()
---

<article
  class="border-border border-t py-5 first:border-t-0 sm:py-6"
  data-essay-entry={entry.id}
>
  <Link
    href={`/essays/${entry.id}`}
    class="group flex min-h-20 flex-col gap-3 sm:flex-row sm:items-start sm:justify-between"
  >
    <div class="min-w-0 grow">
      <time
        datetime={entry.data.date.toISOString()}
        class="text-muted-foreground text-xs tracking-wide"
      >
        {formatDate(entry.data.date)}
      </time>
      <h3
        class="mt-2 text-xl leading-snug font-medium text-pretty group-hover:underline"
      >
        {entry.data.title}
      </h3>
      {
        description && (
          <p
            class="text-muted-foreground mt-3 max-w-2xl text-sm leading-relaxed"
            data-essay-description
          >
            {description}
          </p>
        )
      }
    </div>
    {
      entry.data.image && (
        <div class="w-full shrink-0 sm:w-40" data-essay-image>
          <LqipImage
            src={entry.data.image}
            alt={entry.data.title}
            width={640}
            height={400}
            class="w-full"
            imgClass="object-cover"
          />
        </div>
      )
    }
  </Link>
</article>
