<span data-footnote-sidenote-root hidden></span>

<script>
  const setupSidenotes = () => {
    const roots = document.querySelectorAll<HTMLElement>(
      '[data-footnote-sidenote-root]',
    )

    for (const root of roots) {
      const article = root.previousElementSibling
      if (
        !(article instanceof HTMLElement) ||
        !article.matches('article.prose')
      )
        continue

      article
        .querySelectorAll('.footnote-sidenote')
        .forEach((sidenote) => sidenote.remove())

      const markers = article.querySelectorAll<HTMLAnchorElement>(
        'a[data-footnote-ref]',
      )

      for (const [index, marker] of Array.from(markers).entries()) {
        const target = article.querySelector<HTMLElement>(
          `#${CSS.escape(marker.hash.slice(1))}`,
        )
        if (!target) continue

        const sidenote = document.createElement('aside')
        sidenote.className = 'footnote-sidenote'
        sidenote.setAttribute('role', 'note')
        sidenote.tabIndex = 0

        const number = document.createElement('span')
        number.className = 'footnote-sidenote-number'
        number.textContent = `[${marker.textContent?.trim() || index + 1}]`

        const body = document.createElement('div')
        body.className = 'footnote-sidenote-body'
        for (const child of Array.from(target.childNodes)) {
          body.append(child.cloneNode(true))
        }
        body
          .querySelectorAll<HTMLElement>('[data-footnote-backref]')
          .forEach((backlink) => backlink.remove())
        body.querySelectorAll<HTMLElement>('[id]').forEach((element) => {
          element.removeAttribute('id')
        })
        body
          .querySelectorAll<HTMLElement>(
            '[aria-labelledby], [aria-describedby], [for]',
          )
          .forEach((element) => {
            element.removeAttribute('aria-labelledby')
            element.removeAttribute('aria-describedby')
            element.removeAttribute('for')
          })

        sidenote.append(number, body)
        const reference = marker.closest('sup') ?? marker
        reference.after(sidenote)
      }
    }
  }

  document.addEventListener('astro:page-load', setupSidenotes)
</script>
