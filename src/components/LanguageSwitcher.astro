---
import { defaultLang } from '@/i18n/ui'
import { getAlternateLocalePath } from '@/i18n/utils'
import { getRelativeLocaleUrl } from 'astro:i18n'

const currentLocale = Astro.currentLocale ?? defaultLang
const { locale: targetLocale, path } = getAlternateLocalePath(
  Astro.url.pathname,
  currentLocale,
)
const href =
  targetLocale === defaultLang
    ? path
    : getRelativeLocaleUrl(targetLocale, path.replace(/^\//, ''))

const isZhCurrent = currentLocale === defaultLang
const arrow = isZhCurrent ? '→' : '←'
const activeClass = 'text-foreground font-medium'
const inactiveClass =
  'text-foreground/60 transition-colors group-hover:font-medium group-hover:text-[#8a6bab]'
---

<a
  href={href}
  class="group flex items-center gap-1 text-sm"
  aria-label={`Switch to ${targetLocale === 'en' ? 'English' : '中文'}`}
>
  <span class={isZhCurrent ? activeClass : inactiveClass}>中</span>
  <span
    class="text-foreground/60 relative inline-grid w-3 place-items-center font-mono"
  >
    <span class="transition-opacity group-hover:opacity-0">/</span>
    <span
      class="absolute inset-0 grid place-items-center opacity-0 transition-opacity group-hover:font-medium group-hover:opacity-100"
      aria-hidden="true"
    >
      {arrow}
    </span>
  </span>
  <span class={!isZhCurrent ? activeClass : inactiveClass}>EN</span>
</a>
